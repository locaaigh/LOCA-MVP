# ─────────────────────────────────────────────────────────────
# LOCA MVP — variables de entorno (todas OPCIONALES)
# La app funciona en MODO DEMO sin ninguna de estas variables.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Dominios — split web de marketing / plataforma
# Un solo codebase y un solo deploy sirven los dos hosts; el
# middleware rutea por header Host (ver src/middleware.ts).
#
#   heyloca.ai      → web de marketing (/, /precios, /contacto…)
#   app.heyloca.ai  → plataforma (/dashboard, /onboarding, /login…)
#
# NEXT_PUBLIC_APP_ORIGIN es el INTERRUPTOR del split:
#   - vacía  → todo convive en un dominio (dev y deploy inicial).
#   - seteada → el middleware redirige las rutas cruzadas y los CTAs
#     de la web apuntan al subdominio (appHref en lib/marketing/config).
#
# En Vercel cargarlas con scope Production SOLAMENTE: en Preview harían
# que los CTAs de la web apunten al app de producción. Son NEXT_PUBLIC_*,
# así que se inlinean en build time → cambiarlas exige redeploy.
# Detalle completo en docs/DEPLOY-PROD.md §6.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ORIGIN=
# Canónico de la web (robots.ts, sitemap.ts y metadataBase del layout).
# Su default es el apex "https://heyloca.ai", así que si el canónico es el
# www hay que setearla explícita o el sitemap listaría URLs que redirigen.
# En producción hoy: https://www.heyloca.ai
NEXT_PUBLIC_MARKETING_ORIGIN=

# Proveedor de texto: anthropic | openai (default: anthropic si hay key, sino openai)
AI_TEXT_PROVIDER=anthropic

# Proveedor de imágenes: gemini | openai (default: gemini si hay key, sino openai)
AI_IMAGE_PROVIDER=gemini

# Google Gemini — imágenes (Nano Banana)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Anthropic (Claude) — recomendado para textos
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — textos (si AI_TEXT_PROVIDER=openai) e imágenes
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# ─────────────────────────────────────────────────────────────
# Supabase — auth + persistencia + storage de imágenes
# Sin estas variables la app funciona igual pero solo en modo
# demo local (datos en el navegador, sin cuentas reales).
# Copiá los valores de Settings → API en tu proyecto Supabase.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo la usa el servidor. NUNCA exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Meta (Instagram/Facebook) — OAuth y publicación
# Credenciales de la app en developers.facebook.com.
# Sin estas variables la conexión con Meta queda deshabilitada.
# ─────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Opcional: si no está, se deriva del origin del request.
# Debe estar registrada como "Valid OAuth Redirect URI" en Meta Console.
# Con dominios separados, fijarla al subdominio de la plataforma para que
# el redirect_uri no dependa de por qué host entró el usuario:
#   https://app.heyloca.ai/api/integrations/meta/callback
META_OAUTH_REDIRECT_URI=
# Clave de 32 bytes en base64 para cifrar tokens (openssl rand -base64 32)
META_TOKEN_ENCRYPTION_KEY=
# Opcional: pisar los scopes del OAuth (separados por coma) si la app de
# Meta todavía no tiene habilitados los permisos de Instagram.
# META_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts
# Protege el cron de refresh de tokens (Vercel lo manda como Bearer token).
# Generá uno con: openssl rand -hex 32
CRON_SECRET=

# ─────────────────────────────────────────────────────────────
# PostHog — analytics de producto (pageviews, funnels, session replay).
# Sin estas variables PostHog queda deshabilitado (no-op); los eventos
# de negocio igual se guardan en la tabla events de Supabase.
# Key del proyecto en PostHog → Settings → Project → "Project API Key".
# Ver docs/ANALYTICS-PLAN.md.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel (opcional): ID del pixel creado en Business Manager (INFINIDAD).
# Sin esta variable el pixel no se carga. Cargarla cuando se vayan a correr
# ads (o antes, para construir audiencias desde tráfico orgánico).
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads (opcional, sin Tag Manager): ID del Google tag (AW-XXXXXXXXX)
# y send_to de la acción de conversión de signup ("AW-XXXXXXXXX/AbCdEf").
# Sin estas variables no se carga nada. Cargarlas al activar Google Ads.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=

# ─────────────────────────────────────────────────────────────
# Overlay de debug de uso de IA (tokens/costo) — SOLO para testing del MVP.
# El log en la base de datos (tabla ai_usage_log) funciona siempre,
# independientemente de esta variable; esto solo controla si se ve en
# pantalla. Poner en false (o borrar) cuando termine la etapa de pruebas.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHOW_AI_USAGE=false
